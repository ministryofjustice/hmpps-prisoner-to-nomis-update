    "/integrations/people/{personIdentifier}/periods-of-custody" : {
      "get" : {
        "tags" : [ "Integrations" ],
        "summary" : "Retrieve periods of custody ordered in reverse chronological order (most recent first).",
        "operationId" : "periodsOfCustodyFor",
        "parameters" : [ {
          "name" : "personIdentifier",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "401" : {
            "description" : "Unauthorised, requires a valid Oauth2 token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Forbidden, requires an appropriate role",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "All periods of custody for the provided identifier returned in reverse chronological order. If current, concludedAt will be null.",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodsOfCustody"
                }
              }
            }
          }
        }
      }
    },
    "/integrations/people/{personIdentifier}/periods-of-custody/latest" : {
      "get" : {
        "tags" : [ "Integrations" ],
        "summary" : "Retrieve the most recent period of custody if one exists. The status and concluded date can be used to determine if it is current.",
        "operationId" : "latestPeriodFor",
        "parameters" : [ {
          "name" : "personIdentifier",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "401" : {
            "description" : "Unauthorised, requires a valid Oauth2 token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Forbidden, requires an appropriate role",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No period of custody exists for the provided identifier",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "The most recent period of custody for the provided identifier. If current, concludedAt will be null.",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodOfCustody"
                }
              }
            }
          }
        }
      }
    },
    "/integrations/people/{personIdentifier}/periods-of-custody/at" : {
      "get" : {
        "tags" : [ "Integrations" ],
        "summary" : "Retrieve the period of custody for a given date and time. The status and concluded date can be used to determine if it is current.",
        "operationId" : "periodAt",
        "parameters" : [ {
          "name" : "personIdentifier",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "anchorDateTime",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        } ],
        "responses" : {
          "401" : {
            "description" : "Unauthorised, requires a valid Oauth2 token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Forbidden, requires an appropriate role",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No period of custody exists for the provided identifier at the given date and time",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "The period of custody for the provided identifier covering the date and time provided. If current, concludedAt will be null.",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PeriodOfCustody"
                }
              }
            }
          }
        }
      }
    }
